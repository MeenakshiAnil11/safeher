@startuml SafeHer Component Diagrams

skinparam component {
  BackgroundColor #E8F4F8
  BorderColor #2C5F7D
  FontSize 11
}
skinparam interface {
  BackgroundColor #FFF3CD
  BorderColor #FF8C00
}

' ============================================
' Component Diagram 1: Overall System Architecture
' ============================================
@startuml System_Architecture

title SafeHer System Component Architecture

package "Frontend Layer" {
  component [React Application] as ReactApp
  component [User Interface] as UI
  component [Admin Interface] as AdminUI
}

package "Backend Layer" {
  component [Express Server] as Express
  component [Authentication Service] as AuthService
  component [API Controllers] as Controllers
  component [Business Logic] as BusinessLogic
}

package "ML Services Layer" {
  component [Flask ML API] as FlaskAPI
  component [Health Risk Service] as HealthRiskML
  component [Mood Prediction Service] as MoodML
  component [Symptom Classification Service] as SymptomML
  component [Exercise Recommendation Service] as ExerciseML
}

package "Data Layer" {
  database "MongoDB Atlas" as MongoDB
  component [Mongoose ODM] as Mongoose
}

package "External Services" {
  component [Firebase Auth] as Firebase
  component [Email Service] as EmailService
  component [Google Maps API] as GoogleMaps
  component [Razorpay Payment] as Razorpay
}

ReactApp --> Express : HTTP/REST API
UI --> ReactApp : uses
AdminUI --> ReactApp : uses

Express --> AuthService : uses
Express --> Controllers : routes to
Controllers --> BusinessLogic : uses
BusinessLogic --> Mongoose : uses
Mongoose --> MongoDB : queries

Controllers --> FlaskAPI : HTTP requests
FlaskAPI --> HealthRiskML : uses
FlaskAPI --> MoodML : uses
FlaskAPI --> SymptomML : uses
FlaskAPI --> ExerciseML : uses

AuthService --> Firebase : OAuth
BusinessLogic --> EmailService : sends emails
ReactApp --> GoogleMaps : location services
ReactApp --> Razorpay : payment processing

@enduml

