  -notes: String
  -createdAt: Date
  +save(): Promise
}

class MoodLog {
  -_id: ObjectId
  -user: ObjectId
  -date: Date
  -mood: String
  -symptoms: Array<String>
  -notes: String
  -createdAt: Date
  +save(): Promise
}

class Sleep {
  -_id: ObjectId
  -user: ObjectId
  -sleepHours: Number
  -quality: String
  -bedtime: String
  -wakeTime: String
  -date: Date
