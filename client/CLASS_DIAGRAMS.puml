class HealthController {
  +getVitals(req, res): Promise
  +createVital(req, res): Promise
  +getSymptoms(req, res): Promise
  +createSymptom(req, res): Promise
  +getHealthRisk(req, res): Promise
}

User "1" --> "*" Vital : owns
User "1" --> "*" Symptom : owns
User "1" --> "*" MoodLog : owns
User "1" --> "*" Sleep : owns
User "1" --> "*" Nutrition : owns
User "1" --> "*" HealthGoal : owns
HealthController ..> Vital : manages
HealthController ..> Symptom : manages
HealthController ..> HealthGoal : manages

@enduml

' ============================================
' Class Diagram 4: ML Services Classes
' ============================================
@startuml ML_Services_Classes

title ML Services Classes

class HealthRiskService {
  -model: KNeighborsClassifier
  -scaler: StandardScaler
  +loadModel(): Boolean
  +predict(features): Object
  +getRecommendations(riskLevel): Array<String>
}

class MoodPredictionService {
  -model: SVC (SVM)
  -scaler: StandardScaler
  +loadModel(): Boolean
  +predict(features): Object
}

class SymptomClassificationService {
  -model: GaussianNB
  -scaler: StandardScaler
  +loadModel(): Boolean
  +predictCategory(symptoms): String
  +predictSeverity(symptoms): Number
}

class ExerciseRecommendationService {
  -model: KNeighborsClassifier
  -scaler: StandardScaler
  -encoders: Dict
  +loadModel(): Boolean
  +recommend(features): Object
  +getExplanation(exercise, phase): String
}

class MLController {
  +predictHealthRisk(req, res): Promise
  +predictMood(req, res): Promise
  +classifySymptom(req, res): Promise
  +recommendExercise(req, res): Promise
}

MLController ..> HealthRiskService : uses
MLController ..> MoodPredictionService : uses
MLController ..> SymptomClassificationService : uses
MLController ..> ExerciseRecommendationService : uses

@enduml

' ============================================
' Class Diagram 5: Safety & Emergency Classes
' ============================================
@startuml Safety_Emergency_Classes

title Safety and Emergency Classes

class SOSLog {
  -_id: ObjectId
  -user: ObjectId
  -coords: Object {lat, lng}
  -address: String
  -message: String
  -status: String (open/handled/closed)
  -handledBy: ObjectId
  -createdAt: Date
  +save(): Promise
  +updateStatus(status): Promise
}

class Contact {
  -_id: ObjectId
  -user: ObjectId
  -name: String
  -number: String
  -email: String
  -relationship: String
  -fcmToken: String
  +save(): Promise
}

class SafeZone {
  -_id: ObjectId
  -user: ObjectId
  -name: String
  -latitude: Number
  -longitude: Number
  -radius: Number
  -isActive: Boolean
  +save(): Promise
  +isWithinZone(lat, lng): Boolean
}

class Helpline {
  -_id: ObjectId
  -name: String
  -number: String
  -category: String
  -region: String
  -active: Boolean
  +save(): Promise
}

class SOSController {
  +sendSOS(req, res): Promise
  +getSOSHistory(req, res): Promise
  +updateSOSStatus(req, res): Promise
  +notifyContacts(contacts, sosData): Promise
}

class EmailService {
  +sendSOSAlert(contact, sosData): Promise
  +sendEmail(to, subject, body): Promise
}

User "1" --> "*" SOSLog : creates
User "1" --> "*" Contact : has
User "1" --> "*" SafeZone : defines
SOSController ..> SOSLog : manages
SOSController ..> Contact : uses
SOSController ..> EmailService : uses
EmailService ..> Contact : notifies

@enduml

