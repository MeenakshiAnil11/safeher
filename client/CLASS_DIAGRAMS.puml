@startuml Health_Tracking_Classes

title Health Tracking Classes

class Vital {
  -_id: ObjectId
  -user: ObjectId
  -recordedAt: Date
  -weightKg: Number
  -heightCm: Number
  -systolic: Number
  -diastolic: Number
  -heartRateBpm: Number
  -bmi: Number
  -bloodSugar: Number
  -ironLevel: Number
  -cholesterol: Number
  -createdAt: Date
