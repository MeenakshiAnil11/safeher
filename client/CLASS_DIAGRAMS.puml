@startuml SafeHer Class Diagrams

skinparam class {
  BackgroundColor #E8F4F8
  BorderColor #2C5F7D
  FontSize 11
}
skinparam arrow {
  Color #2C5F7D
  Thickness 2
}

' ============================================
' Class Diagram 1: User & Authentication Classes
' ============================================
@startuml User_Authentication_Classes

title User and Authentication Classes

class User {
  -_id: ObjectId
  -name: String
  -email: String
  -password: String (hashed)
  -phone: String
  -dateOfBirth: Date
  -googleId: String
  -role: String (user/admin/superadmin)
  -isActive: Boolean
  -emailVerified: Boolean
  -settings: Object
  -subscription: Object
  -createdAt: Date
  -updatedAt: Date
  +matchPassword(password): Boolean
  +save(): Promise
  +findById(id): User
  +findOne(query): User
}

class AuthController {
  +register(req, res): Promise
  +login(req, res): Promise
  +googleLogin(req, res): Promise
  +forgotPassword(req, res): Promise
  +resetPassword(req, res): Promise
  +logout(req, res): Promise
}

class ProtectedRoute {
  -token: String
  +verifyToken(token): Boolean
  +checkAuth(req, res, next): Middleware
}

class AdminRoute {
  -role: String
  +checkAdmin(req, res, next): Middleware
}

User "1" --> "*" : has
AuthController ..> User : uses
ProtectedRoute ..> User : validates
AdminRoute ..> User : validates

@enduml

' ============================================
' Class Diagram 2: Period Tracking Classes
' ============================================
@startuml Period_Tracking_Classes

title Period Tracking Classes

class Period {
  -_id: ObjectId
  -user: ObjectId (ref: User)
  -startDate: Date
  -endDate: Date
  -duration: Number
  -intensity: String (light/medium/heavy)
  -symptoms: Array<String>
  -mood: String
  -notes: String
  -basalBodyTemperatureC: Number
  -createdAt: Date
  +calculateDuration(): Number
  +save(): Promise
  +findByUser(userId): Array<Period>
}

class FertilityLog {
  -_id: ObjectId
  -user: ObjectId
  -date: Date
  -bbt: Number
  -cervicalMucus: String
  -ovulationTest: String
  -intercourse: Boolean
  -cycleDay: Number
  -phase: String
  -mood: String
  -energy: Number
  -stress: Number
  +save(): Promise
  +getFertilityInsights(): Object
}

class PregnancyLog {
  -_id: ObjectId
  -user: ObjectId
  -date: Date
  -week: Number
  -trimester: String
  -weightKg: Number
  -symptoms: Array<Object>
  -fetalMovement: Boolean
  -kickCount: Number
  -mood: String
  -medications: Array<String>
  +save(): Promise
  +getPregnancyProgress(): Object
}

class PerimenopauseLog {
  -_id: ObjectId
  -user: ObjectId
  -date: Date
  -cycleLength: Number
  -periodFlow: String
  -hotFlashes: Boolean
  -moodSwings: Boolean
  -sleepHours: Number
  -medications: Array<String>
  +save(): Promise
}

class PeriodController {
  +getPeriods(req, res): Promise
  +createPeriod(req, res): Promise
  +updatePeriod(req, res): Promise
  +deletePeriod(req, res): Promise
  +getPredictions(req, res): Promise
}

User "1" --> "*" Period : owns
User "1" --> "*" FertilityLog : owns
User "1" --> "*" PregnancyLog : owns
User "1" --> "*" PerimenopauseLog : owns
PeriodController ..> Period : manages
PeriodController ..> FertilityLog : manages
PeriodController ..> PregnancyLog : manages

@enduml

